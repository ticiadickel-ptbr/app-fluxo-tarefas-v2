# Copie para .env (ignorado pelo Git). Sem valores secretos aqui.
# Liga o atendimento ao GitHub: ticket novo vira issue origin:app e o workflow ai-agents.yml responde.
AGENT_RUNTIME=github-actions
GITHUB_REPO=ticiadickel-ptbr/app-fluxo-tarefas-v2
# O backend usa o login do GitHub CLI desta máquina (gh auth login). Caminho do gh, se não estiver no PATH:
# GH_BIN=C:\Program Files\GitHub CLI\gh.exe
